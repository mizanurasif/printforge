# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Neon: direct string for migrations and local work; on Vercel use the pooled one (host contains -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Any long random string: npx auth secret
NEXTAUTH_SECRET=
# Only needed locally (on Vercel leave it out, or set it to your own domain)
NEXTAUTH_URL=http://localhost:3000

# Optional: Hugging Face token (type Read) for a bigger 2D to 3D quota
HF_TOKEN=

# Set automatically on Vercel when you connect a Blob store. Without it, uploads are saved in /public (local only).
BLOB_READ_WRITE_TOKEN=
